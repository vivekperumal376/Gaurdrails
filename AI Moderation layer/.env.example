PORT=3000
# Optional; defaults to config/moderation-policy.yaml.
# POLICY_PATH=config/moderation-policy.yaml

# Local development only. Replace with a randomly generated secret of at least 32 characters.
AUTH_MODE=local
JWT_SECRET=local-development-only-change-to-a-random-value-32-plus
JWT_ISSUER=genai-guardrail-gateway-local
JWT_AUDIENCE=genai-guardrail-gateway

# For an OIDC provider instead, set AUTH_MODE=oidc and configure these values.
# OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# JWT_ISSUER=https://identity.example.com/
# JWT_AUDIENCE=your-api-audience