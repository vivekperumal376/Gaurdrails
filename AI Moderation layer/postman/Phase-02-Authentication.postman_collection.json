{
  "info": {
    "name": "Guardrail Gateway - Phase 02 Authentication",
    "description": "Checks bearer-token authentication on a protected moderation endpoint. Supply a valid local user token and optionally an expired token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userToken", "value": "" },
    { "key": "expiredToken", "value": "" },
    { "key": "invalidToken", "value": "not-a-valid-jwt" }
  ],
  "item": [
    {
      "name": "Reject request without bearer token (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"A safe authentication check.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/moderate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 401 UNAUTHENTICATED', function () {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error).to.eql('UNAUTHENTICATED');",
            "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Reject invalid bearer token (401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{invalidToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"A safe authentication check.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/moderate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 401 UNAUTHENTICATED', function () {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error).to.eql('UNAUTHENTICATED');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Reject expired bearer token (401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{expiredToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"A safe authentication check.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/moderate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 401 UNAUTHENTICATED', function () {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error).to.eql('UNAUTHENTICATED');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Accept valid user token and reach protected route (200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"A safe authentication check.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/moderate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('valid user token reaches the protected route', function () { pm.response.to.have.status(200); });",
            "pm.test('moderation response includes normalized content', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.normalizedContent).to.eql('A safe authentication check.');",
            "  pm.expect(body.requestId).to.be.a('string');",
            "});"
          ]
        }
      }]
    }
  ]
}
