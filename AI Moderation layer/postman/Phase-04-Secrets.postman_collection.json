{
  "info": {
    "name": "Guardrail Gateway - Phase 04 Secrets",
    "description": "Focused Postman checks for secret detection, response non-disclosure, and tester-role protection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "testerToken", "value": "" },
    { "key": "userToken", "value": "" }
  ],
  "item": [
    {
      "name": "Detect API key assignment (BLOCK; value not echoed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"api_key = demo-secret-value-12345\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/detect/secrets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('detects API key without disclosing its value', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.matched).to.eql(true);",
            "  pm.expect(body.category).to.eql('API_KEY');",
            "  pm.expect(body.recommendedAction).to.eql('BLOCK');",
            "  pm.expect(body.ruleId).to.eql('SECRET-APIKEY-001');",
            "  pm.expect(pm.response.text()).not.to.include('demo-secret-value-12345');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Ordinary use of key (ALLOW)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Use the key points from the meeting summary.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/detect/secrets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('does not flag benign wording', function () {",
            "  const body = pm.response.json();",
            "  pm.expect(body.matched).to.eql(false);",
            "  pm.expect(body.recommendedAction).to.eql('ALLOW');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Reject caller without token (401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"api_key = demo-secret-value-12345\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/detect/secrets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 401 without authentication', function () { pm.response.to.have.status(401); });",
            "pm.test('does not echo submitted secret', function () {",
            "  pm.expect(pm.response.json().error).to.eql('UNAUTHENTICATED');",
            "  pm.expect(pm.response.text()).not.to.include('demo-secret-value-12345');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Reject authenticated user role (403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"api_key = demo-secret-value-12345\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/detect/secrets"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns 403 for wrong role', function () { pm.response.to.have.status(403); });",
            "pm.test('returns FORBIDDEN without disclosing submitted secret', function () {",
            "  pm.expect(pm.response.json().error).to.eql('FORBIDDEN');",
            "  pm.expect(pm.response.text()).not.to.include('demo-secret-value-12345');",
            "});"
          ]
        }
      }]
    }
  ]
}
