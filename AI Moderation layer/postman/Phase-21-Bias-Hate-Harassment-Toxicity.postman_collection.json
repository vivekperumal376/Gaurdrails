{
  "info": {
    "name": "Guardrail Gateway - Phase 21 Bias, Hate, Harassment and Toxicity",
    "description": "Exercises bounded deterministic indicators, quoted educational context handling, benign identity discussion, and configured category actions. This is a reference ruleset, not a provider classifier or comprehensive safety assessment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "testerToken", "value": "" }
  ],
  "item": [
    {
      "name": "Targeted harassment receives safe response",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"You are worthless and pathetic.\"\n}" },
        "url": "{{baseUrl}}/api/v1/detect/content-safety"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('categorizes targeted harassment', function () {",
        "  const body = pm.response.json();",
        "  pm.expect(body.categories).to.include.deep({ name: 'HARASSMENT', severity: 'MEDIUM' });",
        "  pm.expect(body.recommendedAction).to.eql('SAFE_RESPONSE');",
        "});"
      ] } }]
    },
    {
      "name": "Quoted educational discussion is allowed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"This educational report analyzes the quoted harassment phrase: 'you are an idiot.'\"\n}" },
        "url": "{{baseUrl}}/api/v1/detect/content-safety"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('allows quoted educational discussion', function () {",
        "  const body = pm.response.json();",
        "  pm.expect(body.categories).to.eql([]);",
        "  pm.expect(body.recommendedAction).to.eql('ALLOW');",
        "});"
      ] } }]
    },
    {
      "name": "Direct protected-group hate is blocked",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"All immigrants are inferior and should be excluded.\"\n}" },
        "url": "{{baseUrl}}/api/v1/detect/content-safety"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('categorizes protected-group hate and blocks by policy', function () {",
        "  const body = pm.response.json();",
        "  pm.expect(body.categories).to.include.deep({ name: 'HATE', severity: 'HIGH' });",
        "  pm.expect(body.recommendedAction).to.eql('BLOCK');",
        "});"
      ] } }]
    },
    {
      "name": "Benign identity discussion is allowed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"The event celebrates LGBTQ people and their contributions to the community.\"\n}" },
        "url": "{{baseUrl}}/api/v1/detect/content-safety"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('does not flag benign identity discussion', function () {",
        "  const body = pm.response.json();",
        "  pm.expect(body.categories).to.eql([]);",
        "  pm.expect(body.recommendedAction).to.eql('ALLOW');",
        "});"
      ] } }]
    },
    {
      "name": "Low-severity toxicity warns",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{testerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"That was stupid.\"\n}" },
        "url": "{{baseUrl}}/api/v1/detect/content-safety"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('warns on non-targeted low-severity toxicity', function () {",
        "  const body = pm.response.json();",
        "  pm.expect(body.categories).to.include.deep({ name: 'TOXICITY', severity: 'LOW' });",
        "  pm.expect(body.recommendedAction).to.eql('WARN');",
        "});"
      ] } }]
    }
  ]
}
